{
  "manifest_version": 3,
  "name": "Mellow",
  "version": "0.0.1",
  "description": "Toolbar popup that opens a full dashboard page; content filtering features WIP.",
  "action": {
    "default_title": "Open Mellow",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "static/assets/layout.svg",
      "32": "static/assets/layout.svg",
      "48": "static/assets/layout.svg",
      "128": "static/assets/layout.svg"
    }
  },
  "background": {
    "service_worker": "worker/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "static/assets/layout.svg",
    "32": "static/assets/layout.svg",
    "48": "static/assets/layout.svg",
    "128": "static/assets/layout.svg"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"]
}


